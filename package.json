{
	"name": "letra",
	"version": "0.5.0",
	"private": true,
	"description": "SDD-agnostic memory framework for AI coding agents",
	"type": "module",
	"bin": {
		"letra": "packages/cli/dist/index.js"
	},
	"workspaces": [
		"packages/types",
		"packages/client",
		"packages/cli",
		"packages/ui",
		"packages/design-toolkit"
	],
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:client": "npm -w packages/client run dev",
		"dev:cli": "npm -w packages/cli run dev",
		"build": "node scripts/build-cli.mjs",
		"build:client": "npm -w packages/client run build",
		"lint": "biome check packages/",
		"typecheck": "npm -w packages/cli run typecheck && npm -w packages/ui run typecheck",
		"test": "npm -w packages/cli run test",
		"test:client": "npm -w packages/client run test",
		"ds:playground": "npm -w packages/design-toolkit run playground",
		"ds:check": "npm -w packages/design-toolkit run check",
		"ds:validate": "npm -w packages/design-toolkit run validate"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.19.17",
		"pkg": "^5.8.1",
		"tsup": "^8.5.0",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
