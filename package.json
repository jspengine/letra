{
	"name": "@letra-ai/cli",
	"version": "0.1.13",
	"description": "SDD-agnostic memory framework for AI coding agents",
	"type": "module",
	"bin": {
		"letra": "dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsup",
		"build:binary": "pkg . --out-path dist/bin",
		"lint": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"sdd",
		"spec-driven-development",
		"ai-coding",
		"agent",
		"memory",
		"context"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/letra-ai/letra.git"
	},
	"dependencies": {
		"chalk": "^5.4.1",
		"commander": "^12.1.0",
		"glob": "^11.0.0",
		"ora": "^9.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.19.17",
		"pkg": "^5.8.1",
		"tsup": "^8.5.0",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"pkg": {
		"scripts": "dist/**/*.js",
		"assets": ".letra/**/*",
		"targets": ["node22-win-x64", "node22-linux-x64", "node22-macos-x64"],
		"outputPath": "dist/bin"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
