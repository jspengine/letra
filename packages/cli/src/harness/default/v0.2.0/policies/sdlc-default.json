{
  "id": "sdlc-default",
  "version": "0.2.0",
  "review": {
    "minReviewers": 1,
    "requireHuman": false,
    "allowAgentToComment": true,
    "allowAgentToApprove": false
  },
  "security": {
    "blockOnCritical": true,
    "blockOnHigh": true,
    "allowAgentToOverride": false
  },
  "pr": {
    "requireDescription": true,
    "requireChecksPassing": true,
    "allowAgentToMerge": false
  }
}
