{
	"name": "@letra/ui",
	"version": "0.3.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./styles": "./dist/index.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build && node scripts/build-ds-catalog.mjs",
		"storybook:a11y": "node scripts/check-storybook-ci.mjs --a11y",
		"storybook:visual": "node scripts/check-storybook-ci.mjs --visual",
		"catalog:build": "node scripts/build-ds-catalog.mjs",
		"catalog:audit": "node scripts/audit-ds-components.mjs"
	},
	"peerDependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^8.6.18",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/addon-interactions": "^8.6.14",
		"@storybook/addon-themes": "^8.6.18",
		"@storybook/react": "^8.6.18",
		"@storybook/react-vite": "^8.6.18",
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"storybook": "^8.6.18",
		"tailwindcss": "^4.3.2",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.22.0",
		"tailwind-merge": "^3.6.0"
	}
}
