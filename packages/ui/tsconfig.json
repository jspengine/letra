{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"paths": {
			"@letra/types": ["../types/src/index.ts"],
			"@letra/ui": ["./src/index.ts"],
			"@/*": ["../client/src/*"]
		},
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist"
	},
	"include": ["src"]
}
